# Browser service (REST + MCP streamable HTTP) on the tailnet. Container binds
# 127.0.0.1:{{ browser_service_port }}; this vhost adds TLS. The service itself requires a bearer token.
# MCP uses long-lived streaming responses, so buffering is off and timeouts are generous.
server {
    listen {{ tailscale_ip }}:{{ browser_service_nginx_port }} ssl;
    server_name {{ tailscale_hostname }};

    ssl_certificate {{ cert_dir }}/speedracer.crt;
    ssl_certificate_key {{ cert_dir }}/speedracer.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 25m;   # profile state uploads
    proxy_buffering off;

    location / {
        proxy_pass http://127.0.0.1:{{ browser_service_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }
}
