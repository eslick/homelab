# Arcana 2 admin console — nginx reverse proxy (Tailscale TLS)
# LiveView needs WebSocket upgrade headers; single node, so no ip_hash upstream.
server {
    listen {{ tailscale_ip }}:{{ arcana2_nginx_port }} ssl;
    server_name {{ tailscale_hostname }};

    ssl_certificate {{ cert_dir }}/speedracer.crt;
    ssl_certificate_key {{ cert_dir }}/speedracer.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    location / {
        proxy_pass http://127.0.0.1:{{ arcana2_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }
}
