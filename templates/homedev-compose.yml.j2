services:
  homedev:
    build:
      context: /home/eslick/projects/homedev
      dockerfile: Dockerfile
    image: homedev:local
    container_name: homedev
    network_mode: host
    volumes:
      - /home/eslick/projects/homedev/src:/app/src
      - /home/eslick/projects/homedev/dev:/app/dev
      - /home/eslick/projects/homedev/resources:/app/resources
    environment:
      CRDB_URL: "jdbc:postgresql://localhost:5433/homedev?user=yugabyte&sslmode=disable"  # name kept for the homedev code; now points at YugabyteDB
      MINIO_ENDPOINT: "http://localhost:9000"
      MINIO_ACCESS_KEY: "{{ vault_minio_root_user }}"
      MINIO_SECRET_KEY: "{{ vault_minio_root_password }}"
      VLLM_BASE_URL: "http://localhost:8000/v1"
      HA_URL: "http://localhost:8123"
      HA_TOKEN: "{{ vault_ha_token }}"
      OPENROUTER_API_KEY: "{{ vault_openrouter_api_key }}"
    restart: unless-stopped
