# MinIO community edition is source-only (upstream stopped publishing images;
# minio/minio is gone from Docker Hub). Build from the pinned upstream tag.
FROM golang:1.24-bookworm AS build

ARG MINIO_VERSION={{ minio_version }}

ENV CGO_ENABLED=0 GOTOOLCHAIN=auto

RUN git clone --depth 1 --branch "${MINIO_VERSION}" https://github.com/minio/minio /src
WORKDIR /src
RUN go build -tags kqueue -trimpath --ldflags "$(go run buildscripts/gen-ldflags.go)" -o /minio

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /minio /usr/local/bin/minio

EXPOSE 9000 9001
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/minio"]
