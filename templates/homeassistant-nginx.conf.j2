server {
    listen {{ tailscale_ip }}:{{ homeassistant_nginx_port }} ssl;
    server_name {{ tailscale_hostname }};

    ssl_certificate {{ cert_dir }}/speedracer.crt;
    ssl_certificate_key {{ cert_dir }}/speedracer.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:{{ homeassistant_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support (HA's live-updating frontend uses this heavily)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }
}
