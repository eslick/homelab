services:
  minio:
    build:
      context: .
      args:
        MINIO_VERSION: "{{ minio_version }}"
    image: minio-local:{{ minio_version }}
    container_name: minio
    command: server /data --console-address ":9001"
    volumes:
      - minio-data:/data
    ports:
      - "{{ minio_api_port }}:9000"
      - "127.0.0.1:{{ minio_console_port }}:9001"  # nginx handles external access; see playbooks/nginx.yml
    env_file:
      - {{ secrets_path }}/minio.env   # root-only; holds MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
    networks:
      - {{ docker_network }}
    restart: unless-stopped

volumes:
  minio-data:

networks:
  {{ docker_network }}:
    external: true
