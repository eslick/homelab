services:
  llm-gateway:
    build:
      context: {{ gateway_src }}
      dockerfile: Dockerfile
    image: llm-gateway:local
    container_name: llm-gateway
    ports:
      - "127.0.0.1:{{ llm_gateway_port }}:8080"
    environment:
      MODELS_JSON: '{{ {"default": llm_default_model, "models": llm_models} | to_json }}'
      IDLE_TIMEOUT_SECONDS: "{{ llm_idle_timeout }}"
      STARTUP_TIMEOUT_SECONDS: "{{ llm_startup_timeout }}"
      LOAD_WAIT_SECONDS: "{{ llm_load_wait }}"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro  # start/stop the inference containers
    networks:
      {{ docker_network }}:
        aliases:
          - sglang-watcher  # name Arcana's "homelab" profile still uses (sglang-watcher:8080)
    restart: unless-stopped

networks:
  {{ docker_network }}:
    external: true
