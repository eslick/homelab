<!-- ===================== PIPELINE ===================== -->
<section id="pipeline">
  <h2>Intent → proof → running kernel <small>how the subsystems are used together</small></h2>
  <div class="card">
  <div class="diagram">
<svg viewBox="0 0 1200 170" role="img" aria-label="Pipeline from intent through elicitation, specification, verification, registry promotion and kernel execution to the journal and conformance monitors">
  <defs>
