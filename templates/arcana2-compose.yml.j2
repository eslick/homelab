# Arcana 2 live-dev node. Managed by playbooks/arcana2.yml; adapted from
# docker/compose.dev.yml in the arcana2 repo (see docs/handoff/homelab-arcana2.md).
# Project name is kept as `arcana-dev` so the existing named volumes are reused.
name: arcana-dev
services:
  arcana:
    build:
      context: {{ arcana2_src_path }}
      dockerfile: docker/Dockerfile.dev
      args:
        UID: "1000"
        GID: "1000"
    image: arcana-dev:local
    container_name: arcana-dev
    # hostname + cookie must stay consistent: dev-watch.sh and `make dev.iex`
    # derive the node name arcana@arcana-dev.
    hostname: arcana-dev
    restart: unless-stopped
    init: true
    env_file:
      - {{ secrets_path }}/arcana2.env   # root-only; holds ANTHROPIC_API_KEY
    environment:
      ARCANA_ADMIN: "1"
      ARCANA_ADMIN_BIND: "0.0.0.0"
      ARCANA_COOKIE: "{{ arcana2_cookie }}"
      ARCANA_DATABASE_URL: "{{ arcana2_database_url }}"
      ARCANA_STORE_ROOT: /workspace/tmp/arcana_store
    ports:
      - "127.0.0.1:{{ arcana2_port }}:4100"  # nginx handles external access; see playbooks/nginx.yml
    volumes:
      - {{ arcana2_src_path }}:/workspace
      - arcana-build:/workspace/_build
      - arcana-deps:/workspace/deps
      - arcana-kernel-target:/workspace/native/kernel_wasm/target
      - arcana-mix:/home/arcana/.mix
      - arcana-hex:/home/arcana/.hex
    networks:
      - {{ docker_network }}

volumes:
  arcana-build:
  arcana-deps:
  arcana-kernel-target:
  arcana-mix:
  arcana-hex:

networks:
  {{ docker_network }}:
    external: true
