services:
  vllm-dense:
    image: "{{ vllm_image }}"
    container_name: vllm-dense
    # No host port binding — the llm-gateway proxies via the Docker network (http://vllm-dense:8000)
    environment:
      - HF_TOKEN={{ hugging_face_token }}
      - HUGGING_FACE_HUB_TOKEN={{ hugging_face_token }}
    command: >
      {{ vllm_model_id }}
      --served-model-name {{ vllm_served_model_name }}
      --tensor-parallel-size {{ vllm_tensor_parallel_size }}
      --gpu-memory-utilization {{ vllm_gpu_memory_fraction }}
      --max-model-len {{ vllm_max_model_len }}
      --dtype {{ vllm_dtype }}
      --kv-cache-dtype {{ vllm_kv_cache_dtype }}
      --enable-prefix-caching
      --host 0.0.0.0 --port 8000
      {{ vllm_extra_args | default('') }}
    volumes:
      - vllm-models:/root/.cache/huggingface  # shared HF cache with SGLang
    networks:
      - {{ docker_network }}
    ipc: host
    shm_size: "4g"
    restart: "no"  # gateway manages lifecycle; do not auto-restart
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 300s

volumes:
  vllm-models:
    external: true  # shared with SGLang

networks:
  {{ docker_network }}:
    external: true
