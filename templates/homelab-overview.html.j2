{#- Optional Arcana-supplied fragments (contract: docs/arcana-overview-contract.md). Missing file => empty string. -#}
{%- set arcana_summary = lookup('ansible.builtin.file', arcana_overview_dir ~ '/overview-summary.html', errors='ignore') | default('', true) -%}
{%- set arcana_hierarchy = lookup('ansible.builtin.file', arcana_overview_dir ~ '/overview-hierarchy.html', errors='ignore') | default('', true) -%}
{%- set arcana_details = lookup('ansible.builtin.file', arcana_overview_dir ~ '/overview-details.html', errors='ignore') | default('', true) -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>speedracer — homelab overview</title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #0f1115; --panel: #171a21; --panel2: #1d212a; --border: #2a303c;
    --text: #e6e8ec; --muted: #9aa4b2; --accent: #6ea8fe;
    --c-net: #6ea8fe; --c-app: #5fd0a0; --c-gpu: #b794f6; --c-data: #f0b45a;
    --c-sys: #8fa3b8; --c-ts: #4fd1d9; --c-ext: #9aa4b2;
    --ok: #5fd0a0; --warn: #f0b45a; --err: #f07178;
  }
  @media (prefers-color-scheme: light) {
    :root {
      --bg: #f4f5f8; --panel: #ffffff; --panel2: #f0f2f6; --border: #d6dbe3;
      --text: #1b1f27; --muted: #566073; --accent: #1a5fd0;
      --c-net: #1a5fd0; --c-app: #12805a; --c-gpu: #6d3fc0; --c-data: #a35f08;
      --c-sys: #4b5d73; --c-ts: #0a7f8a; --c-ext: #566073;
      --ok: #12805a; --warn: #a35f08; --err: #c4343f;
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 4rem; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    line-height: 1.45;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  code, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.85em; }

  /* ---- top bar + nav ---- */
  .top { background: var(--panel); border-bottom: 1px solid var(--border); }
  .top-in { max-width: 1280px; margin: 0 auto; padding: 1rem 1.25rem 0.75rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; }
  .top h1 { font-size: 1.3rem; margin: 0; font-weight: 650; }
  .top .sub { color: var(--muted); font-size: 0.85rem; }
  .top .spacer { flex: 1; }
  nav.tabs { position: sticky; top: 0; z-index: 5; background: var(--panel); border-bottom: 1px solid var(--border); }
  nav.tabs div { max-width: 1280px; margin: 0 auto; padding: 0 1.25rem; display: flex; gap: 0.25rem; overflow-x: auto; }
  nav.tabs a { color: var(--muted); padding: 0.6rem 0.8rem; font-size: 0.88rem; white-space: nowrap; border-bottom: 2px solid transparent; }
  nav.tabs a:hover { color: var(--text); text-decoration: none; border-bottom-color: var(--accent); }

  main { max-width: 1280px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
  section { margin-bottom: 2.5rem; }
  h2 { font-size: 1.05rem; margin: 0 0 0.9rem; font-weight: 650; letter-spacing: 0.01em; }
  h2 small { color: var(--muted); font-weight: 400; font-size: 0.8rem; margin-left: 0.5rem; }
  h3 { font-size: 0.95rem; margin: 0 0 0.6rem; }
  p { margin: 0 0 0.7rem; }
  .muted { color: var(--muted); }

  /* ---- cards / widgets ---- */
  .card { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 1rem 1.1rem; margin-bottom: 1rem; }
  .grid { display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
  .grid2 { display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .widget { background: var(--panel); border: 1px solid var(--border); border-left: 3px solid var(--c-sys); border-radius: 10px; padding: 0.85rem 1rem; }
  .widget.k-app { border-left-color: var(--c-app); } .widget.k-data { border-left-color: var(--c-data); }
  .widget.k-gpu { border-left-color: var(--c-gpu); } .widget.k-net { border-left-color: var(--c-net); }
  .widget.k-ts { border-left-color: var(--c-ts); }
  .w-label { color: var(--muted); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.07em; }
  .w-value { font-size: 1.3rem; font-weight: 650; margin: 0.15rem 0; }
  .w-value small { font-size: 0.78rem; font-weight: 500; color: var(--muted); white-space: nowrap; }
  .w-sub { color: var(--muted); font-size: 0.8rem; }
  .group-label { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; margin: 1.1rem 0 0.5rem; }
  .pill { display: inline-block; font-size: 0.68rem; font-weight: 600; padding: 0.1rem 0.5rem; border-radius: 99px; vertical-align: middle; border: 1px solid var(--border); color: var(--muted); }
  .pill.ok { color: var(--ok); border-color: var(--ok); } .pill.warn { color: var(--warn); border-color: var(--warn); }
  .pill.err { color: var(--err); border-color: var(--err); } .pill.info { color: var(--accent); border-color: var(--accent); }
  .tag { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.72rem; color: var(--muted); background: var(--panel2); border: 1px solid var(--border); border-radius: 5px; padding: 0.02rem 0.4rem; margin-left: 0.3rem; }

  /* ---- diagrams ---- */
  .diagram { overflow-x: auto; }
  .diagram svg { display: block; width: 100%; min-width: 880px; height: auto; }
  .legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; font-size: 0.78rem; color: var(--muted); margin-top: 0.7rem; }
  .legend i { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 3px; border: 1.5px solid; margin-right: 0.35rem; vertical-align: -0.1rem; }
  svg .node { fill: var(--panel2); stroke: var(--border); stroke-width: 1.3; }
  svg .k-net { stroke: var(--c-net); fill: color-mix(in srgb, var(--c-net) 11%, var(--panel)); }
  svg .k-app { stroke: var(--c-app); fill: color-mix(in srgb, var(--c-app) 11%, var(--panel)); }
  svg .k-data { stroke: var(--c-data); fill: color-mix(in srgb, var(--c-data) 11%, var(--panel)); }
  svg .k-gpu { stroke: var(--c-gpu); fill: color-mix(in srgb, var(--c-gpu) 11%, var(--panel)); }
  svg .k-sys { stroke: var(--c-sys); fill: color-mix(in srgb, var(--c-sys) 11%, var(--panel)); }
  svg .k-ts { stroke: var(--c-ts); fill: color-mix(in srgb, var(--c-ts) 11%, var(--panel)); }
  svg .k-ext { stroke: var(--c-ext); fill: color-mix(in srgb, var(--c-ext) 8%, var(--panel)); stroke-dasharray: 4 3; }
  svg .zone { fill: none; stroke: var(--border); stroke-width: 1.3; stroke-dasharray: 6 5; }
  svg .zone-host { fill: color-mix(in srgb, var(--panel2) 45%, transparent); stroke: var(--muted); stroke-dasharray: none; stroke-width: 1.2; }
  svg .zone-ts { stroke: var(--c-ts); }
  svg .edge { fill: none; stroke: var(--muted); stroke-width: 1.6; }
  svg .edge-ts { fill: none; stroke: var(--c-ts); stroke-width: 1.6; stroke-dasharray: 5 4; }
  svg .bus { fill: none; stroke: var(--c-net); stroke-width: 3; }
  svg .ah { fill: var(--muted); } svg .ah-ts { fill: var(--c-ts); }
  svg .chip { fill: var(--bg); stroke: var(--border); stroke-width: 1; }
  svg .t { fill: var(--text); font: 600 13px -apple-system, "Segoe UI", Roboto, sans-serif; }
  svg .s { fill: var(--muted); font: 11px -apple-system, "Segoe UI", Roboto, sans-serif; }
  svg .m { fill: var(--muted); font: 10.5px ui-monospace, SFMono-Regular, Menlo, monospace; }
  svg .ct { fill: var(--text); font: 600 10.5px ui-monospace, SFMono-Regular, Menlo, monospace; }
  svg .z { fill: var(--muted); font: 600 10.5px -apple-system, "Segoe UI", Roboto, sans-serif; letter-spacing: 0.08em; text-transform: uppercase; }
  svg .tc { text-anchor: middle; } svg .te { text-anchor: end; }

  /* ---- tables / lists ---- */
  .tbl { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .tbl th { text-align: left; color: var(--muted); font-weight: 600; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.4rem 0.6rem; border-bottom: 1px solid var(--border); }
  .tbl td { padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  .tbl tr:last-child td { border-bottom: 0; }
  .scroll { overflow-x: auto; }
  dl.kv { display: grid; grid-template-columns: max-content 1fr; gap: 0.3rem 1rem; margin: 0; font-size: 0.85rem; }
  dl.kv dt { color: var(--muted); } dl.kv dd { margin: 0; }
  ol.steps { margin: 0; padding-left: 1.2rem; font-size: 0.88rem; } ol.steps li { margin-bottom: 0.35rem; }
  ul.tree, ul.tree ul { list-style: none; margin: 0; padding-left: 1.2rem; border-left: 1px solid var(--border); }
  ul.tree { padding-left: 0; border-left: 0; font-size: 0.88rem; }
  ul.tree li { margin: 0.2rem 0; }
  ul.tree summary { cursor: pointer; }
  .ph { border: 1px dashed var(--border); border-radius: 10px; padding: 1rem 1.1rem; color: var(--muted); font-size: 0.85rem; }
  footer { color: var(--muted); font-size: 0.75rem; margin-top: 2rem; }
</style>
</head>
<body>

<header class="top"><div class="top-in">
  <div>
    <h1>speedracer <span class="muted" style="font-weight:400">· homelab overview</span></h1>
    <div class="sub">{{ tailscale_hostname }} · single-node Docker Compose host · configuration view (snapshot {{ overview_snapshot_date }})</div>
  </div>
  <div class="spacer"></div>
  <span class="pill info">Tailscale-only ingress</span>
  <span class="pill ok">Ansible-managed</span>
  <a href="/">← Services index</a>
</div></header>

<nav class="tabs"><div>
  <a href="#summary">Summary</a>
  <a href="#config">Configuration</a>
  <a href="#inventory">Inventory</a>
  <a href="#network">Home network</a>
  <a href="#tailscale">Tailscale access</a>
  <a href="#hierarchy">Hierarchy</a>
  <a href="#arcana">Arcana 2</a>
  <a href="#ops">Operations</a>
</div></nav>

<main>

<!-- ===================== SUMMARY ===================== -->
<section id="summary">
  <h2>Summary <small>what this machine is and what it runs</small></h2>
  <div class="grid">
    <div class="widget k-net">
      <div class="w-label">Host</div>
      <div class="w-value">speedracer</div>
      <div class="w-sub">Ubuntu 24.04 LTS · Threadripper 3960X (24 cores) · 125 GiB RAM</div>
    </div>
    <div class="widget k-app">
      <div class="w-label">Containers</div>
      <div class="w-value">6 <small>running + 1 on demand</small></div>
      <div class="w-sub">Home Assistant, MinIO, YugabyteDB, 2× Arcana, sglang-watcher; sglang starts when the LLM API is called</div>
    </div>
    <div class="widget k-gpu">
      <div class="w-label">GPU · local LLM</div>
      <div class="w-value">2× RTX 3090 <small>48 GB</small></div>
      <div class="w-sub">Qwen3.6-35B-A3B-AWQ, tensor-parallel ×2, OpenAI-compatible API on :{{ vllm_nginx_port }}, stops after 5 idle minutes</div>
    </div>
    <div class="widget k-data">
      <div class="w-label">Database</div>
      <div class="w-value">YugabyteDB <small>YSQL</small></div>
      <div class="w-sub">The only SQL database (2025.2.6.0). Loopback-only :5433; Arcana uses <span class="mono">arcana_dev</span></div>
    </div>
    <div class="widget k-data">
      <div class="w-label">Storage <span class="muted">(snapshot)</span></div>
      <div class="w-value">914 GB <small>root · 59%</small></div>
      <div class="w-sub">RAID 5 4×4 TB on /mnt/data (4/4 healthy) · NAS 11 TB on /mnt/nas (53% used)</div>
    </div>
    <div class="widget k-ts">
      <div class="w-label">Network</div>
      <div class="w-value">100.74.60.51 <small>tailnet</small></div>
      <div class="w-sub">LAN 192.168.50.100 · gateway 192.168.50.1 · 3 devices on the tailnet</div>
    </div>
    <div class="widget k-app">
      <div class="w-label">Backups</div>
      <div class="w-value">Nightly <small>03:00</small></div>
      <div class="w-sub">restic → NAS (/mnt/nas/backups/homelab); the NAS syncs to S3 on its own</div>
    </div>
    <div class="widget k-sys">
      <div class="w-label">Change control</div>
      <div class="w-value">Ansible only</div>
      <div class="w-sub">playbooks/ + templates/ in git, a runbook per change, daily Claude health check at 08:00</div>
    </div>
  </div>

  <div class="group-label">Arcana 2</div>
  <div class="grid">
    <div class="widget k-app">
      <div class="w-label">Runtime</div>
      <div class="w-value">2 <small>dev nodes</small></div>
      <div class="w-sub"><span class="mono">arcana-dev</span> :4100 · <span class="mono">arcana-dev-2</span> :4101</div>
    </div>
    <div class="widget k-net">
      <div class="w-label">Admin console</div>
      <div class="w-value"><a href="https://{{ tailscale_hostname }}:{{ arcana2_nginx_port }}">:{{ arcana2_nginx_port }}</a></div>
      <div class="w-sub">nginx TLS → 127.0.0.1:{{ arcana2_port }}</div>
    </div>
    <div class="widget k-data">
      <div class="w-label">Backend</div>
      <div class="w-value"><span class="mono">arcana_dev</span></div>
      <div class="w-sub">YugabyteDB on homelab-net (yugabytedb:5433)</div>
    </div>
{% if arcana_summary | length > 0 %}
{{ arcana_summary }}
{% endif %}
  </div>
{% if arcana_summary | length == 0 %}
  <p class="muted" style="margin-top:0.7rem;font-size:0.8rem">Arcana-specific tiles will appear here once <code>overview-summary.html</code> exists in the arcana2 repo — see <a href="#arcana">Arcana 2</a>.</p>
{% endif %}
</section>

<!-- ===================== CONFIGURATION DIAGRAM ===================== -->
<section id="config">
  <h2>Configuration diagram <small>ingress → containers → host services → storage</small></h2>
  <div class="card">
  <div class="diagram">
<svg viewBox="0 0 1400 850" role="img" aria-label="Homelab configuration: Tailscale ingress through UFW and nginx to Docker containers, host services, and storage">
  <defs>
    <marker id="a-cfg" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="ah"/></marker>
  </defs>

  <!-- clients + host zone -->
  <rect class="node k-ts" x="40" y="14" width="260" height="46" rx="8"/>
  <text class="t" x="56" y="34">Tailnet clients</text><text class="s" x="56" y="50">MacBook · iPhone (see Tailscale access)</text>
  <path class="edge" d="M170 60V112" marker-end="url(#a-cfg)"/>
  <rect class="zone zone-host" x="20" y="80" width="1160" height="680" rx="14"/>
  <text class="z te" x="1164" y="99">speedracer · Ubuntu 24.04 · Threadripper 3960X · 125 GiB RAM</text>

  <!-- ingress row -->
  <rect class="node k-ts" x="40" y="112" width="260" height="52" rx="8"/>
  <text class="t" x="56" y="134">tailscale0</text><text class="s" x="56" y="152">100.74.60.51 · MagicDNS + TLS cert</text>
  <rect class="node k-net" x="340" y="112" width="300" height="52" rx="8"/>
  <text class="t" x="356" y="134">UFW firewall</text><text class="s" x="356" y="152">default deny · allow per port on tailscale0</text>
  <rect class="node k-sys" x="700" y="112" width="460" height="52" rx="8"/>
  <text class="t" x="716" y="134">Ansible-only change control</text><text class="s" x="716" y="152">playbooks/ + templates/ → GitHub · runbooks/ for every change</text>
  <path class="edge" d="M300 138H340" marker-end="url(#a-cfg)"/>
  <path class="edge" d="M490 164V200" marker-end="url(#a-cfg)"/>

  <!-- nginx -->
  <rect class="node k-net" x="40" y="200" width="1120" height="56" rx="8"/>
  <text class="t" x="58" y="224">nginx — sole ingress: TLS termination + reverse proxy</text>
  <text class="s" x="58" y="243">Tailscale-issued certificate · proxies to 127.0.0.1 ports · also serves the static index and this overview on :443 (:80 redirects)</text>

  <!-- nginx -> containers -->
  <path class="edge" d="M144 256V326" marker-end="url(#a-cfg)"/>
  <path class="edge" d="M372 256V326" marker-end="url(#a-cfg)"/>
  <path class="edge" d="M600 256V326" marker-end="url(#a-cfg)"/>
  <path class="edge" d="M828 256V326" marker-end="url(#a-cfg)"/>
  <path class="edge" d="M1056 256V326" marker-end="url(#a-cfg)"/>
  <rect class="chip" x="108" y="278" width="72" height="18" rx="9"/><text class="ct tc" x="144" y="291">:{{ homeassistant_nginx_port }}</text>
  <rect class="chip" x="336" y="278" width="72" height="18" rx="9"/><text class="ct tc" x="372" y="291">:{{ vllm_nginx_port }}</text>
  <rect class="chip" x="564" y="278" width="72" height="18" rx="9"/><text class="ct tc" x="600" y="291">:{{ minio_console_nginx_port }}</text>
  <rect class="chip" x="792" y="278" width="72" height="18" rx="9"/><text class="ct tc" x="828" y="291">:{{ yugabytedb_ui_nginx_port }}</text>
  <rect class="chip" x="1020" y="278" width="72" height="18" rx="9"/><text class="ct tc" x="1056" y="291">:{{ arcana2_nginx_port }}</text>

  <!-- docker zone -->
  <rect class="zone" x="250" y="300" width="920" height="226" rx="10"/>
  <text class="z" x="262" y="317">homelab-net</text>

  <rect class="node k-app" x="40" y="326" width="208" height="70" rx="8"/>
  <text class="t" x="54" y="348">homeassistant</text><text class="s" x="54" y="365">Home Assistant Core · host net</text><text class="m" x="54" y="382">:{{ homeassistant_port }} on the host</text>

  <rect class="node k-gpu" x="268" y="326" width="208" height="70" rx="8"/>
  <text class="t" x="282" y="348">sglang-watcher</text><text class="s" x="282" y="365">lazy-start proxy · idle 5 min</text><text class="m" x="282" y="382">127.0.0.1:{{ vllm_port }}</text>
  <path class="edge" d="M372 396V424" marker-end="url(#a-cfg)"/>
  <text class="m" x="382" y="414">docker.sock</text>
  <rect class="node k-gpu" x="268" y="424" width="208" height="70" rx="8"/>
  <text class="t" x="282" y="446">sglang</text><text class="s" x="282" y="463">Qwen3.6-35B-A3B-AWQ</text><text class="m" x="282" y="480">TP=2 · starts on demand</text>

  <rect class="node k-data" x="496" y="326" width="208" height="70" rx="8"/>
  <text class="t" x="510" y="348">minio</text><text class="s" x="510" y="365">S3 storage · built from source</text><text class="m" x="510" y="382">API :9000 · UI :9001</text>

  <rect class="node k-data" x="724" y="326" width="208" height="70" rx="8"/>
  <text class="t" x="738" y="348">yugabytedb</text><text class="s" x="738" y="365">the SQL database (YSQL)</text><text class="m" x="738" y="382">127.0.0.1:5433 · UI :7000</text>

  <rect class="node k-app" x="952" y="326" width="208" height="70" rx="8"/>
  <text class="t" x="966" y="348">arcana-dev</text><text class="s" x="966" y="365">Arcana 2 dev node (Elixir)</text><text class="m" x="966" y="382">127.0.0.1:4100 + tailnet IP</text>
  <rect class="node k-app" x="952" y="424" width="208" height="70" rx="8"/>
  <text class="t" x="966" y="446">arcana-dev-2</text><text class="s" x="966" y="463">Arcana 2 dev node #2</text><text class="m" x="966" y="480">tailnet IP :4101 · direct</text>
  <path class="edge" d="M952 361H932" marker-end="url(#a-cfg)"/>
  <path class="edge" d="M952 459H828V396" marker-end="url(#a-cfg)"/>
  <text class="m tc" x="890" y="451">YSQL arcana_dev</text>

  <!-- external: Anthropic -->
  <rect class="node k-ext" x="1215" y="326" width="170" height="70" rx="8"/>
  <text class="t" x="1229" y="348">Anthropic API</text><text class="s" x="1229" y="365">LLM calls from Arcana</text><text class="m" x="1229" y="382">HTTPS · API key</text>
  <path class="edge" d="M1160 361H1215" marker-end="url(#a-cfg)"/>
  <path class="edge" d="M1160 459H1198V361"/>

  <!-- host services -->
  <text class="z" x="40" y="543">Host services (systemd · cron)</text>
  <rect class="node k-sys" x="40" y="552" width="208" height="70" rx="8"/>
  <text class="t" x="54" y="574">syncthing</text><text class="s" x="54" y="591">Obsidian vault sync</text><text class="m" x="54" y="608">tailnet :22000 → /opt/vaults</text>
  <rect class="node k-sys" x="496" y="552" width="208" height="70" rx="8"/>
  <text class="t" x="510" y="574">system daemons</text><text class="s" x="510" y="591">sshd · docker · tailscaled</text><text class="m" x="510" y="608">smartd · mdmonitor · power</text>
  <rect class="node k-sys" x="724" y="552" width="208" height="70" rx="8"/>
