<!-- ===================== SUMMARY ===================== -->
<section id="summary">
  <h2>Summary <small>what this machine is and what it runs</small></h2>
  <div class="grid">
    <div class="widget k-net">
      <div class="w-label">Host</div>
      <div class="w-value">speedracer</div>
      <div class="w-sub">Ubuntu 24.04 LTS · Threadripper 3960X (24 cores) · 125 GiB RAM</div>
    </div>
    <div class="widget k-app">
      <div class="w-label">Containers</div>
      <div class="w-value">6 <small>running + 1 on demand</small></div>
      <div class="w-sub">Home Assistant, MinIO, YugabyteDB, 2× Arcana, sglang-watcher; sglang starts when the LLM API is called</div>
    </div>
    <div class="widget k-gpu">
      <div class="w-label">GPU · local LLM</div>
      <div class="w-value">2× RTX 3090 <small>48 GB</small></div>
      <div class="w-sub">Qwen3.6-35B-A3B-AWQ, tensor-parallel ×2, OpenAI-compatible API on :{{ vllm_nginx_port }}, stops after 5 idle minutes</div>
    </div>
    <div class="widget k-data">
      <div class="w-label">Database</div>
      <div class="w-value">YugabyteDB <small>YSQL</small></div>
      <div class="w-sub">The only SQL database (2025.2.6.0). Loopback-only :5433; Arcana uses <span class="mono">arcana_dev</span></div>
    </div>
    <div class="widget k-data">
      <div class="w-label">Storage <span class="muted">(snapshot)</span></div>
      <div class="w-value">914 GB <small>root · 59%</small></div>
      <div class="w-sub">RAID 5 4×4 TB on /mnt/data (4/4 healthy) · NAS 11 TB on /mnt/nas (53% used)</div>
    </div>
    <div class="widget k-ts">
      <div class="w-label">Network</div>
      <div class="w-value">100.74.60.51 <small>tailnet</small></div>
      <div class="w-sub">LAN 192.168.50.100 · gateway 192.168.50.1 · 3 devices on the tailnet</div>
