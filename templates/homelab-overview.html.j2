<section id="ops">
  <h2>Operations <small>backup, monitoring and change control</small></h2>
  <div class="grid2">
    <div class="card">
      <h3>Backup</h3>
      <dl class="kv">
        <dt>Tool</dt><dd>restic, nightly at 03:00</dd>
        <dt>Repository</dt><dd class="mono">/mnt/nas/backups/homelab</dd>
        <dt>Paths</dt><dd class="mono">/home /etc /opt/compose /opt/vaults /opt/cache /var/lib/docker/volumes</dd>
        <dt>Offsite</dt><dd>the NAS syncs to S3 independently</dd>
      </dl>
    </div>
    <div class="card">
      <h3>Monitoring</h3>
      <dl class="kv">
        <dt>Health check</dt><dd>Claude headless run at 08:00 → <span class="mono">health-reports/</span> (disk, memory, containers, restic age, failed units, security updates, temperatures)</dd>
        <dt>Mail</dt><dd>alerts and cron output relay through postfix to Gmail</dd>
        <dt>Disks</dt><dd>smartd and mdmonitor</dd>
      </dl>
    </div>
    <div class="card">
      <h3>Change control</h3>
      <dl class="kv">
        <dt>Rule</dt><dd>every system change goes through an Ansible playbook, dry run first</dd>
        <dt>Record</dt><dd>commit to GitHub + <span class="mono">runbooks/YYYY-MM-DD-task.md</span></dd>
        <dt>Containers</dt><dd>compose templates in <span class="mono">templates/</span> deployed to <span class="mono">/opt/compose/&lt;service&gt;/</span></dd>
      </dl>
    </div>
  </div>
</section>

