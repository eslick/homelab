server {
    listen {{ tailscale_ip }}:{{ minio_console_nginx_port }} ssl;
    server_name {{ tailscale_hostname }};

    ssl_certificate {{ cert_dir }}/speedracer.crt;
    ssl_certificate_key {{ cert_dir }}/speedracer.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 0;  # console proxies file uploads through this port too

    location / {
        proxy_pass http://127.0.0.1:{{ minio_console_port }};
        proxy_http_version 1.1;
        # $http_host keeps the :port. The console's WebSocket (object browser) rejects
        # a handshake whose Origin (with port) does not match Host (403) if it is dropped.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # MinIO's console UI uses WebSockets for live updates
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        chunked_transfer_encoding off;
    }
}
