<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ ansible_hostname | default('speedracer') }} — services</title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #0f1115;
    --card: #171a21;
    --border: #262b36;
    --text: #e6e8ec;
    --muted: #9aa4b2;
    --accent: #6ea8fe;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    padding: 2.5rem 1.25rem;
  }
  main { max-width: 640px; margin: 0 auto; }
  h1 {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
  }
  p.sub {
    color: var(--muted);
    margin: 0 0 2rem;
    font-size: 0.9rem;
  }
  a.hero {
    display: block;
    border: 1px solid var(--accent);
    background: var(--card);
    border-radius: 10px;
    padding: 0.9rem 1.1rem;
    margin-bottom: 1.25rem;
    text-decoration: none;
    color: var(--text);
  }
  a.hero:hover { background: var(--border); }
  a.hero strong { color: var(--accent); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  li {
    border: 1px solid var(--border);
    background: var(--card);
    border-radius: 10px;
    padding: 0.9rem 1.1rem;
  }
  a.name {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
  }
  a.name:hover { color: var(--accent); }
  .desc {
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 0.2rem;
  }
  .port {
    float: right;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
  }
  footer {
    margin-top: 2rem;
    color: var(--muted);
    font-size: 0.75rem;
  }
</style>
</head>
<body>
<main>
  <h1>{{ tailscale_hostname }}</h1>
  <p class="sub">Services reachable over Tailscale</p>
  <a class="hero" href="/overview.html">
    <strong>Homelab overview →</strong>
    <div class="desc">Server summary, configuration and network diagrams, Tailscale access, Arcana</div>
  </a>
  <ul>
{% for svc in tailscale_services %}
    <li>
      <span class="port">:{{ svc.port }}</span>
      <a class="name" href="https://{{ tailscale_hostname }}:{{ svc.port }}">{{ svc.name }}</a>
      <div class="desc">{{ svc.description }}</div>
    </li>
{% endfor %}
  </ul>
  <footer>Generated by playbooks/nginx.yml — edit tailscale_services there, not this file.</footer>
</main>
</body>
</html>
