protocol=sql
host=0.0.0.0
port=4334
alt-host={{ ansible_hostname | default('localhost') }}

# YugabyteDB YSQL (PostgreSQL-compatible) storage; auth is disabled on this instance, so the
# credentials are placeholders. Not an officially supported Datomic storage: see runbook
# 2026-10-03-consolidate-on-yugabytedb.md
sql-url=jdbc:postgresql://yugabytedb:5433/datomic?sslmode=disable
sql-driver-class=org.postgresql.Driver
sql-user=yugabyte
sql-password=yugabyte

# Memory settings (tune for your server)
memory-index-threshold=32m
memory-index-max=256m
object-cache-max=128m
